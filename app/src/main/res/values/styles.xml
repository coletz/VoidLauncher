<resources>

    <!-- Launcher text colors are always light (drawn over the wallpaper), so the base theme is
         always dark. Spotlight overrides this with a DayNight parent because it has day/night colors. -->
    <style name="BaseAppTheme" parent="Theme.AppCompat.NoActionBar" />

    <style name="CommonAppTheme" parent="BaseAppTheme">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:textColor">@color/default_text_color</item>
        <!--<item name="android:fontFamily">sans-serif-condensed</item>-->

        <item name="android:windowAnimationStyle">@null</item>

        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme" parent="CommonAppTheme" />
</resources>